{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttg-upload-authorizer",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "UPLOAD_SESSIONS",
        "class_name": "UploadSession"
      }
    ]
  },
  "exports": {
    "UploadSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "UPLOAD_AUTH_RATE_LIMITER",
      "namespace_id": "74002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_SIGN_RATE_LIMITER",
      "namespace_id": "74003",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "CLOUDINARY_API_KEY",
      "CLOUDINARY_API_SECRET",
      "TURNSTILE_SECRET_KEY"
    ]
  }
}
